# Copy to backend/.env and adjust. Never commit real credentials.
# This file lists required variable names; secrets stay empty.

ENVIRONMENT=development

# PostgreSQL (production / staging)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Local development fallback:
DATABASE_URL=

# Required in production: random value used to HMAC OTP codes and webhook
# signatures. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Exact allowed browser origins as a JSON array.
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PUBLIC_SITE_URL=http://localhost:5173

# Session cookie
SESSION_COOKIE_NAME=phill_session
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limits and lockout
CONTACT_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_15_MINUTES=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# OTP policy
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUESTS_PER_HOUR=8
# Fixed in code: OTP verification allows 30 checks per client per 15 minutes and
# forgot-password allows 10 requests per client per hour.

# Arkesel (backend only; never prefix with VITE_)
# In development an empty key uses a local transport that logs only a masked phone
# number. In production an empty key makes SMS delivery fail closed; it never
# fabricates a send. Codes are never written to logs or stored in plaintext.
# Delivery webhooks are verified with HMAC-SHA-256 over
# "<timestamp>.<raw body>" using ARKESEL_WEBHOOK_SECRET.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ARKESEL_WEBHOOK_SECRET=
ARKESEL_API_BASE_URL=https://sms.arkesel.com
ARKESEL_TIMEOUT_SECONDS=10
ARKESEL_WEBHOOK_MAX_SKEW_SECONDS=300
# Shown at the start of every OTP SMS.
SMS_BRAND_NAME=Phill Portfolio

# First-run administrator. Created only when absent; password change is forced.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=

# Media library
MEDIA_STORAGE_DIR=storage/media
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_DIMENSION=8000

# Optional contact notification email
CONTACT_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

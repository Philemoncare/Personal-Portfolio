# Copy to backend/.env and adjust. Never commit real credentials.

ENVIRONMENT=development

# PostgreSQL (production / staging)
# DATABASE_URL=postgresql+psycopg://portfolio_user:CHANGE_ME@localhost:5432/portfolio
# Local development fallback used when DATABASE_URL is not set:
DATABASE_URL=sqlite:///./portfolio.db

# Comma-free JSON array of exact allowed origins.
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Session cookie
SESSION_COOKIE_NAME=phill_session
SESSION_TTL_HOURS=72
COOKIE_SECURE=false

# Rate limits
CONTACT_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_15_MINUTES=10

# Initial administrator, used only by `python -m app.scripts.seed`.
# Use a real-looking domain (reserved domains such as .local are rejected by
# the login email validator) and a long unique password.
# Remove this password from .env after seeding if you prefer.
ADMIN_EMAIL=admin@phill.dev
ADMIN_PASSWORD=replace-with-a-long-unique-password
